[
  {
    "id": "hc_01",
    "domain": "healthcare",
    "requirement": "A hospital needs to manage patients and their visits. Each patient has a Medical Record Number, Name, Date of Birth, Gender, and Phone Number. A patient can have many visits (encounters), each with a Visit Number, Admission Date, Discharge Date, and the Department visited. Each visit is recorded for exactly one patient.",
    "output": {
      "Patient": {
        "Attributes": ["Medical Record Number", "Name", "Date of Birth", "Gender", "Phone Number"],
        "Primary key": ["Medical Record Number"],
        "Foreign key": {}
      },
      "Visit": {
        "Attributes": ["Visit Number", "Admission Date", "Discharge Date", "Department", "Medical Record Number"],
        "Primary key": ["Visit Number"],
        "Foreign key": {
          "Medical Record Number": {"Patient": "Medical Record Number"}
        }
      }
    }
  },
  {
    "id": "hc_02",
    "domain": "healthcare",
    "requirement": "A clinic schedules appointments between patients and doctors. Each patient has a Patient ID, Name, and Insurance Number. Each doctor has a Doctor ID, Name, and Specialty. A patient can book many appointments and a doctor can attend many appointments; each appointment has an Appointment ID, Scheduled Time, Duration, and Status.",
    "output": {
      "Patient": {
        "Attributes": ["Patient ID", "Name", "Insurance Number"],
